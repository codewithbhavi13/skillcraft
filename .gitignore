# Ignore node modules
node_modules/

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Ignore build and dependency files
dist/
build/
coverage/

# Ignore lock files (optional, if using only one package manager)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore test coverage
coverage/

# Ignore temporary files
*.swp
*.swo
*.bak
*.tmp
